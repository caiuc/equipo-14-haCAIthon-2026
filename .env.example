# `supabase start` imprime la URL y publishable/anon key para desarrollo local.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Preview local: permite abrir /recycle sin crear cuenta.
# Déjalo en false para probar el flujo real de login.
EXPO_PUBLIC_SKIP_AUTH_FOR_RECYCLE=true

# Adaptador analítico opcional; el MVP usa un adaptador no-op si está vacío.
EXPO_PUBLIC_POSTHOG_KEY=
