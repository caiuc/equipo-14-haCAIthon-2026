{
  "name": "Retorna · HaCAithon 2026",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "forwardPorts": [
    8081
  ],
  "portsAttributes": {
    "8081": {
      "label": "Aplicación",
      "onAutoForward": "openPreview"
    }
  },
  "postAttachCommand": {
    "app": "npx expo start --web --port 8081"
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    }
  },
  "postCreateCommand": "npm install",
  "//": "Con EXPO_PUBLIC_DEMO_MODE=true no se necesitan credenciales"
}
