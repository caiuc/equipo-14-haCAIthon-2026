{
  "name": "retorna",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "web": "expo start --web",
    "web:export": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/data/database.types.ts"
  },
  "dependencies": {
    "@clerk/expo": "^4.2.8",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-query": "^5.101.4",
    "expo": "~57.0.13",
    "expo-auth-session": "~57.0.7",
    "expo-camera": "~57.0.3",
    "expo-constants": "~57.0.11",
    "expo-crypto": "~57.0.1",
    "expo-file-system": "~57.0.4",
    "expo-linking": "~57.0.6",
    "expo-router": "~57.0.13",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.12",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "lucide-react-native": "^1.31.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "~0.21.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.18",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~57.0.1",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  }
